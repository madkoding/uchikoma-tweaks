# ==========================================================================
#  UCHIKOMA // Cyberpunk HUD v4 (COMPACTO)  —  conky 1.8.0 / i686
#
#  Escala reducida ~50% respecto a v3:
#    ancho 250->132 · barras 244->120 · grafos 24->12 · titulo 12->9
#    fuentes 8->7 y 7->6 (el minimo legible en 1024x600)
#
#  Requiere: ~/.conky-bat.sh (bateria; battery_bar del 1.8 esta roto)
#  Transparencia REAL: own_window_argb_visual + compositing xfwm4.
#  Notas: ${loadavg N} exige 1|2|3. Las barras necesitan default_bar_size.
# ==========================================================================

background yes
update_interval 1.0
total_run_times 0

cpu_avg_samples 2
net_avg_samples 2
diskio_avg_samples 2

use_xft yes
xftfont FiraCode Nerd Font:size=7
xftalpha 1

override_utf8_locale yes
imlib_cache_size 0
double_buffer yes
no_buffers yes
text_buffer_size 512
max_user_text 8192
short_units yes
default_bar_size 118 3
default_gauge_size 60 3

# ------------------------- transparencia real -----------------------------
own_window yes
own_window_type normal
own_window_transparent yes
own_window_argb_visual yes
own_window_argb_value 150
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
own_window_colour 000000

border_inner_margin 1
border_outer_margin 0
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no

gap_x 44
gap_y 8
minimum_size 134 0
maximum_width 134
alignment top_right

# ------------------------------ paleta neon -------------------------------
default_color E8F6FF
default_shade_color 000000
default_outline_color 000000

color0 00E5FF   # cian    - primario / CPU / rejilla
color1 FF2E97   # magenta - red subida / alertas
color2 7DFF6B   # verde   - red bajada / OK
color3 FFCC00   # ambar   - temperatura / bateria
color4 9B5DE5   # violeta - etiquetas
color5 5A6C7A   # gris    - texto tenue
color6 FFFFFF   # blanco  - valores

